---
import { NAV, SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header page-grid">
	<div class="bar wide">
		<a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
			<svg class="mark" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true" focusable="false">
				<rect width="32" height="32" rx="8"></rect>
				<path d="M9 22.5V10.2l7 8.1 7-8.1v12.3"></path>
			</svg>
			<span>{SITE.title}</span>
		</a>
		<nav aria-label="Main">
			<ul>
				{
					NAV.map(({ href, label }) => (
						<li>
							<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
			<ThemeToggle />
		</nav>
	</div>
</header>

<style>
	.site-header {
		view-transition-name: site-header;
		padding-block: var(--space-s);
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 var(--space-m);
		min-block-size: 3rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
		line-height: 1.2;

		&:hover .mark rect {
			fill: var(--accent-strong);
		}
	}

	.mark {
		flex: none;

		& rect {
			fill: var(--accent);
			transition: fill 0.15s;
		}
		& path {
			fill: none;
			stroke: var(--bg);
			stroke-width: 2.6;
			stroke-linecap: round;
			stroke-linejoin: round;
		}
	}

	/* Pulled outwards by the links' padding so the text lines up with the
	   edges of the column, whether the nav sits beside the title or wraps
	   below it on a narrow screen. */
	nav {
		display: flex;
		align-items: center;
		gap: var(--space-3xs);
		margin-inline: -0.5rem;
	}

	ul {
		display: flex;
		gap: var(--space-3xs);
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-sans);
		font-size: var(--step--1);
		font-weight: 500;
	}

	nav a {
		display: block;
		padding: 0.5rem;
		border-radius: var(--radius);
		color: var(--text-muted);
		text-decoration: none;

		&:hover {
			color: var(--text);
		}

		&[aria-current='page'] {
			color: var(--text);
			text-decoration: underline;
			text-decoration-color: var(--accent);
			text-decoration-thickness: 2px;
			text-underline-offset: 0.45em;
		}
	}
</style>
