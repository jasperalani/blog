---
import FormattedDate from '../../components/FormattedDate.astro';
import { getPosts, postUrl, readingTime } from '../../components/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getPosts();
const years = Map.groupBy(posts, (post) => post.data.pubDate.getUTCFullYear());
---

<BaseLayout title="All writing" description="Every post on the blog, newest first.">
	<div class="archive page-grid">
		<header class="intro">
			<h1>All writing</h1>
			<p class="lede">
				{posts.length === 1 ? 'One post so far' : `${posts.length} posts`}, newest first.
			</p>
		</header>

		{
			[...years].map(([year, list]) => (
				<section aria-labelledby={`y${year}`}>
					<h2 id={`y${year}`}>{year}</h2>
					<ol role="list">
						{list.map((post) => (
							<li>
								<a href={postUrl(post)}>{post.data.title}</a>
								<span class="meta">
									<FormattedDate date={post.data.pubDate} />
									<span aria-hidden="true">·</span>
									<span>{readingTime(post.body).label}</span>
									{post.data.draft && <span class="draft">Draft</span>}
								</span>
							</li>
						))}
					</ol>
				</section>
			))
		}
	</div>
</BaseLayout>

<style>
	.intro {
		padding-block: var(--space-2xl) var(--space-l);
	}

	.lede {
		margin-block-start: var(--space-xs);
		font-size: var(--step-1);
		font-style: italic;
		color: var(--text-muted);
	}

	section {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: var(--space-s);
		padding-block: var(--space-m);
		border-block-start: 1px solid var(--rule);
	}

	h2 {
		font-family: var(--font-sans);
		font-size: var(--step--1);
		font-weight: 600;
		line-height: 2;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}

	ol {
		display: grid;
		gap: var(--space-m);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		display: grid;
		gap: var(--space-3xs);
	}

	li > a {
		font-size: var(--step-1);
		font-weight: 600;
		line-height: 1.3;
		text-decoration: none;

		&:hover {
			color: var(--accent);
		}
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}

	.draft {
		color: var(--accent);
		font-weight: 600;
	}

	@media (width < 34rem) {
		section {
			grid-template-columns: 1fr;
			gap: var(--space-2xs);
		}
	}
</style>
